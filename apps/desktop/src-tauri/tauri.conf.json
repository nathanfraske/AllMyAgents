{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllMyAgents",
  "version": "0.1.41",
  "identifier": "direct.cec.allmyagents",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm --filter web build && pnpm -w run hub:bundle && pnpm -w run testbed:bundle",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AllMyAgents",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "CEC",
    "homepage": "https://github.com/nathanfraske/AllMyAgents",
    "license": "MIT",
    "copyright": "Copyright (c) CEC. MIT licensed.",
    "category": "DeveloperTool",
    "shortDescription": "Run and supervise a fleet of Claude and Codex agents locally.",
    "longDescription": "AllMyAgents is a local-first desktop hub for running, supervising and coordinating multiple Claude Code and Codex agents against your own projects. It owns the agents' lifecycle, journals every turn, and keeps working across hub restarts.",
    "resources": [
      "hub-runtime/**/*",
      "testbed-runtime/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nathanfraske/AllMyAgents/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMzI1RUNFOUJCNThCMTAKUldRUWk3V2J6bDR5OHErOEZISjVDZkc3djQ1ZlRTRWQ5NXhSZU83UVBXL1VSRmgrTlJVd2pyTDQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
