{
  "name": "allmyagents",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "hub:dev": "pnpm --filter hub dev",
    "hubctl:dev": "pnpm --filter hub hubctl:dev",
    "hub:typecheck": "pnpm --filter hub typecheck",
    "hub:build": "pnpm --filter hub build",
    "hub:bundle": "node scripts/bundle-hub.mjs",
    "desktop": "pnpm --filter desktop tauri dev",
    "desktop:build": "pnpm --filter desktop tauri build",
    "web:dev": "pnpm --filter web dev",
    "web:check": "pnpm --filter web check",
    "login:claude": "pnpm --filter spikes run login claude",
    "login:codex": "pnpm --filter spikes run login codex",
    "spike:claude": "pnpm --filter spikes claude-min",
    "spike:codex": "pnpm --filter spikes codex-min",
    "spike:codex-usage": "pnpm --filter spikes codex-usage",
    "spike:two-accounts": "pnpm --filter spikes two-accounts"
  }
}
